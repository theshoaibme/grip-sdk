# ==============================================================================
# Google AI Browser Mode (udm=50) Configuration
# ==============================================================================

# Search Engine Provider: Pure Chromium Browser AI Mode (No API keys needed)
ANSWER_PROVIDER=google_ai

# Browser automation settings for Google AI Mode
# Run `make verify` once if Google ever prompts for CAPTCHA.
# Persistent session profile saves cookies and state across queries.
BROWSER_HEADLESS=1
BROWSER_CHANNEL=chrome
BROWSER_USER_DATA_DIR=.chrome-profile
BROWSER_TIMEOUT=60
BROWSER_LANG=en
# BROWSER_GL=us

# Conversational Input Sessions TTL (seconds, default: 1 hour)
SESSION_TTL_SEC=3600

# Rate Limiting (Token Bucket per client IP)
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SEC=1

# TTL Cache
CACHE_TTL=300
CACHE_MAX_ENTRIES=500

# Server
PORT=8000
FLASK_DEBUG=0
STREAM_DELAY_MS=20